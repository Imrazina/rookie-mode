# Azure Speech
AZURE_SPEECH_KEY=your-speech-key
AZURE_SPEECH_REGION=your-speech-region

# Microsoft Foundry deployments
AZURE_FOUNDRY_ENDPOINT=https://your-foundry-endpoint.example.com
AZURE_FOUNDRY_API_KEY=your-foundry-key
AZURE_CONTEXT_MODEL=your-context-model-deployment
AZURE_RACE_BRIEF_MODEL=your-race-brief-model-deployment

# Optional fallback when both AI features use the same deployment
AZURE_FOUNDRY_MODEL=your-default-model-deployment

# Prepared public demo clip
DEMO_VIDEO_URL=https://www.youtube.com/watch?v=your-demo-video

# Optional: omit when using OpenF1's unauthenticated public API
OPENF1_ACCESS_TOKEN=
